---
import '../styles/global.css';
import { laden, oeffnungszeiten } from '../data/laden';
interface Props { title: string; description: string; jsonLd?: boolean }
const { title, description, jsonLd = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: laden.name,
  servesCuisine: ['Türkisch', 'Döner'],
  telephone: laden.telefonLink,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', streetAddress: laden.strasse, postalCode: laden.plz, addressLocality: laden.ort, addressCountry: 'DE' },
  openingHoursSpecification: oeffnungszeiten.map((o) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][oeffnungszeiten.indexOf(o)]}`,
    opens: o.von, closes: o.bis === '24:00' ? '23:59' : o.bis,
  })),
};
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- DEMO: nicht indexieren. Für echte Kunden entfernen. -->
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#b3261e" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og.png', Astro.site)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Zum Inhalt springen</a>
  <div class="demo-bar" role="note">
    <strong>Demo-Webseite:</strong> fiktiver Laden, alle Daten und Preise sind Platzhalter.
  </div>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label={`${laden.name}, Startseite`}>
        <img src="/favicon.svg" alt="" width="32" height="32" />
        <span>{laden.name}</span>
      </a>
      <nav aria-label="Hauptnavigation" class="nav">
        <a href="/#karte">Speisekarte</a>
        <a href="/#zeiten">Öffnungszeiten</a>
        <a href="/#standort">Standort</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Farbmodus wechseln" title="Hell/Dunkel">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      </button>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <p><strong>{laden.name}</strong><br />{laden.strasse}, {laden.plz} {laden.ort}</p>
      <p><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></p>
      <p class="small muted">Demo-Projekt. Kein echtes Geschäft.</p>
    </div>
  </footer>
  <script is:inline>
    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = isDark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>
<style>
  .demo-bar { background: var(--c-demo-bg); color: var(--c-demo-text); text-align: center; font-size: var(--fs-small); padding: var(--sp-2) var(--sp-3); }
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--c-bg); border-bottom: 1px solid var(--c-border); }
  .header-inner { display: flex; align-items: center; gap: var(--sp-3); min-height: 64px; }
  .brand { display: flex; align-items: center; gap: var(--sp-2); font-weight: 800; font-size: 1.15rem; color: var(--c-text); text-decoration: none; margin-right: auto; }
  .nav { display: none; gap: var(--sp-4); }
  .nav a { color: var(--c-text); text-decoration: none; font-weight: 600; padding: var(--sp-2) 0; }
  .nav a:hover { color: var(--c-accent); }
  @media (min-width: 768px) { .nav { display: flex; } }
  .theme-toggle { width: 48px; height: 48px; border-radius: var(--r-pill); border: 1px solid var(--c-border); background: var(--c-surface); color: var(--c-text); cursor: pointer; display: grid; place-items: center; }
  .site-footer { border-top: 1px solid var(--c-border); padding: var(--sp-5) 0 calc(var(--sp-5) + 72px); }
  .footer-inner { display: grid; gap: var(--sp-2); }
  @media (min-width: 768px) { .site-footer { padding-bottom: var(--sp-5); } }
</style>
